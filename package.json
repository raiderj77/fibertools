    "test:revenue-path": "node --test tests/revenue-path-check.test.js",
    "test:search-traffic": "node --test tests/formula-library-and-newsletter.test.mjs tests/homepage-focus-and-navigation.test.mjs tests/legacy-search-redirects.test.mjs tests/seo-content-accuracy.test.mjs tests/sitemap-readiness.test.mjs tests/social-preview-metadata.test.mjs tests/tool-referral-loop.test.mjs tests/yarn-weight-reference.test.mjs",
