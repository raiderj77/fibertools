    "react-dom": "19.2.7",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.5",
    "@types/node": "^20",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "^8",
    "eslint-config-next": "15.5.22",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26"
    },
    "sharp": "0.35.3"
