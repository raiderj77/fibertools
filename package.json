{
  "name": "fiberforge",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:content": "node scripts/content-lint.js",
    "test:affiliate": "node scripts/affiliate-check.js",
    "test:indexnow": "node --test tests/indexnow-urls.test.mjs",
    "test:gpc-consent": "node --test tests/gpc-consent.test.mjs",
    "test:pattern-checker": "node --test tests/amigurumi-pattern-checker.test.mjs",
    "test:fabric-substitution": "node --test tests/fabric-substitution.test.mjs",
    "test:designer-preflight": "node --test tests/designer-pattern-preflight.test.mjs",
    "test:revenue-path": "node --test tests/revenue-path-check.test.js",
    "test:search-traffic": "node --test tests/formula-library-and-newsletter.test.mjs tests/legacy-search-redirects.test.mjs tests/seo-content-accuracy.test.mjs tests/sitemap-readiness.test.mjs tests/social-preview-metadata.test.mjs tests/tool-referral-loop.test.mjs",
    "test:stitchproof-distribution": "node --test tests/stitchproof-distribution.test.mjs",
    "test:ui-accessibility": "node --test tests/ui-accessibility.test.mjs",
    "check:revenue-path": "node scripts/revenue-path-check.js",
    "test:security": "node scripts/security-check.js && node --check public/sw.js",
    "test:quality": "node scripts/quality-gate.js",
    "lint:predeploy": "node scripts/predeploy-check.js",
    "prebuild": "npm run lint:predeploy && npm run lint:content"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.50.0",
    "googleapis": "^171.4.0",
    "gray-matter": "^4.0.3",
    "next": "15.5.22",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "^8",
    "eslint-config-next": "15.5.22",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26"
    },
    "sharp": "0.35.3"
  }
}
