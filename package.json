    "test:publication-freeze": "node --test tests/publication-freeze.test.mjs",
    "test:environment-docs": "node --test tests/environment-docs.test.mjs",
    "test:runtime": "node --test tests/runtime-contract.test.mjs",
    "test:focused-page-output": "node --test tests/focused-page-output.test.mjs",
    "test:review-dates": "node --test tests/review-dates.test.mjs",
