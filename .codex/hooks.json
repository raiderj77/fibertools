{
  "description": "Restore concise FiberTools operating context at session start and after compaction.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/session-start.mjs\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; node (Join-Path $root '.codex/hooks/session-start.mjs')\"",
            "statusMessage": "Loading FiberTools operating context",
            "additionalContextLimit": 900
          }
        ]
      }
    ]
  }
}
