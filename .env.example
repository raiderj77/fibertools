INDEXNOW_API_KEY=your_indexnow_api_key_here

# Public build-time switches. Keep both false until the Google Privacy &
# messaging release checklist has been completed in an isolated preview.
NEXT_PUBLIC_GOOGLE_CMP_ENABLED=false
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_ID=ca-pub-7171402107622932

# Server-only, default-off compatibility spike. This emits a nonce policy in
# report-only mode and switches page rendering/offline behavior for testing.
# It does not authorize CMP or AdSense activation.
FIBERTOOLS_NONCE_CSP_MODE=off
